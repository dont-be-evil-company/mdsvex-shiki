{
  "name": "@dont-be-evil-company/mdsvex-shiki",
  "version": "1.5.0",
  "private": false,
  "description": "Shiki syntax highlighter for mdsvex",
  "keywords": [
    "code",
    "hightlight",
    "hightlights",
    "mdsvex",
    "prismjs",
    "shiki",
    "svelte",
    "sveltekit",
    "syntax"
  ],
  "license": "MIT",
  "author": "The Don't Be Evil Company and friends <osse@the-dont-be-evil-company.com>",
  "files": [
    "dist/*.{js,cjs,d.ts,css}",
    "styles.css"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./copyAction": {
      "types": "./dist/copy-action.d.ts",
      "import": "./dist/copy-action.js",
      "require": "./dist/copy-action.cjs"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "test": "vp test",
    "prepublishOnly": "npm run build",
    "clear": "rm -f *.js *.cjs *.d.ts",
    "build": "node build.mjs",
    "publish:npm": "npm publish --access public",
    "publish:github": "npm publish --registry https://npm.pkg.github.com --access public"
  },
  "devDependencies": {
    "@shikijs/transformers": "3.19.0",
    "eslint": "9.39.1",
    "prettier": "3.7.4",
    "shiki": "3.19.0",
    "svelte": "5.45.10",
    "typescript": "5.9.3",
    "vite-plus": "1.0.0"
  },
  "packageManager": "pnpm@12.8.1"
}
